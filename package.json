{
  "name": "nauka-react",
  "version": "0.1.0",
  "private": true,
  "description": "Ćwiczenia live coding z Reacta przed rekrutacją (strong junior / mid).",
  "scripts": {
    "registry": "node scripts/gen-registry.mjs",
    "new": "node scripts/new-exercise.mjs",
    "predev": "npm run registry",
    "dev": "next dev",
    "prebuild": "npm run registry",
    "build": "next build",
    "start": "next start",
    "typecheck": "npm run registry && tsc --noEmit",
    "typecheck:tasks": "tsc --noEmit -p tsconfig.check.json",
    "task": "node scripts/task-branch.mjs"
  },
  "dependencies": {
    "marked": "^15.0.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
